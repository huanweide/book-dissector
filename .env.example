# ============================================================
# book-dissector 环境变量示例
# 复制为 .env 后填入【你自己的】密钥；.env 已被 .gitignore 排除，绝不入库。
# 本文件只放占位符，禁止写入任何真实凭据。
# ============================================================

# 选一个你实际使用的 provider：openai | siliconflow | deepseek | groq | custom
BOOK_DISSECTOR_PROVIDER=deepseek

# API Key（也可以运行时用 --api-key 传入，命令行优先级最高）
BOOK_DISSECTOR_API_KEY=sk-your-key-here

# 自定义 OpenAI 兼容端点（仅 provider=custom 时必填，需含 /v1）
# BOOK_DISSECTOR_BASE_URL=https://your-endpoint.example/v1

# 默认模型（可被 --model 覆盖）
BOOK_DISSECTOR_MODEL=deepseek-chat
